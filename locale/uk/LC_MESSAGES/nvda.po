#. Translators: Category name of Typix commands in NVDA's Input gestures
#. dialog.
#. Translators: Name of the Typix submenu in NVDA menu, Tools.
#. Translators: Title of the Typix category in NVDA's settings dialog.
#. Translators: Summary/title for this add-on, shown on installation and in the
#. Add-on Store
#: globalPlugins/typix/__init__.py:177 globalPlugins/typix/__init__.py:231
#: globalPlugins/typix/settings.py:638 manifest.ini
msgid "Typix"
msgstr "Typix"

#. Translators: Item in NVDA menu, Tools, Typix that opens the custom spelling
#. dictionary.
#: globalPlugins/typix/__init__.py:228
msgid "Manage &Dictionary..."
msgstr "Керування &словником..."

#. Translators: Spoken when the toggle command turns typing sounds on.
#: globalPlugins/typix/__init__.py:305
msgid "Typix sounds on"
msgstr "Звуки Typix увімкнено"

#. Translators: Spoken when the toggle command turns typing sounds off.
#: globalPlugins/typix/__init__.py:308
msgid "Typix sounds off"
msgstr "Звуки Typix вимкнено"

#. Translators: Description of the toggle command in NVDA's Input gestures
#. dialog.
#: globalPlugins/typix/__init__.py:310
msgid "Toggles Typix typing sounds on and off"
msgstr "Вмикає та вимикає звуки набору Typix"

#. Translators: Spoken when the selection spelling check is started while one
#. is already running.
#: globalPlugins/typix/__init__.py:315
msgid "A selection spelling check is already in progress"
msgstr "Перевірка правопису виділеного тексту вже триває"

#. Translators: Spoken when no spelling dictionary is ready yet for the current
#. keyboard language.
#: globalPlugins/typix/__init__.py:340
msgid "Spellcheck dictionary is not available yet, try again in a moment"
msgstr "Словник ще недоступний, спробуйте трохи пізніше"

#. Translators: Description of the spelling command in NVDA's Input gestures
#. dialog.
#: globalPlugins/typix/__init__.py:353
msgid "Checks the spelling of selected text; with nothing selected, fixes the last misspelled word you typed, or reports your typing statistics when there is none"
msgstr "Перевіряє правопис виділеного тексту; якщо нічого не виділено, виправляє останнє слово з помилкою, а якщо такого немає, повідомляє статистику набору"

#. Translators: Spoken when the selection spelling check finds no misspelled
#. words.
#: globalPlugins/typix/__init__.py:402
msgid "No spelling errors found"
msgstr "Помилок не знайдено"

#. Translators: Spoken when the selection spelling check ends without any word
#. replaced.
#: globalPlugins/typix/__init__.py:405
msgid "No changes made"
msgstr "Змін не внесено"

#. Translators: Spoken when corrected text can't be written because the field
#. is read-only.
#: globalPlugins/typix/__init__.py:408
msgid "Cannot replace text, the field is read-only"
msgstr "Не вдалося замінити текст, поле лише для читання"

#. Translators: Choice in the spelling suggestions list. {word} is the
#. misspelled word.
#: globalPlugins/typix/__init__.py:423
#, python-brace-format
msgid "Add {word} to dictionary"
msgstr "Додати {word} до словника"

#. Translators: Choice in the spelling suggestions list that leaves the word as
#. it is.
#: globalPlugins/typix/__init__.py:425
msgid "Skip"
msgstr "Пропустити"

#. Translators: Message of the spelling suggestions dialog. {word} is the
#. misspelled word, {count} the number of suggestions.
#: globalPlugins/typix/__init__.py:429
#, python-brace-format
msgid "{word} is misspelled. {count} suggestion."
msgid_plural "{word} is misspelled. {count} suggestions."
msgstr[0] "{word} написано з помилкою. {count} варіант."
msgstr[1] "{word} написано з помилкою. {count} варіанти."
msgstr[2] "{word} написано з помилкою. {count} варіантів."

#. Translators: Message of the spelling suggestions dialog when there are no
#. suggestions. {word} is the misspelled word.
#: globalPlugins/typix/__init__.py:435
#, python-brace-format
msgid "{word} is misspelled. No suggestions."
msgstr "{word} написано з помилкою. Варіантів немає."

#. Translators: Title of the spelling suggestions dialog.
#: globalPlugins/typix/__init__.py:437
msgid "Spelling suggestions"
msgstr "Варіанти виправлення"

#. Translators: Spoken when focus doesn't return to the text field after the
#. suggestions dialog.
#: globalPlugins/typix/__init__.py:553
msgid "Could not get back to the text, nothing replaced"
msgstr "Не вдалося повернутися до тексту, нічого не замінено"

#. Translators: Spoken when the misspelled word can't be selected safely for
#. replacing. {word} is that word.
#: globalPlugins/typix/__init__.py:558
#, python-brace-format
msgid "Could not select {word} safely, nothing replaced"
msgstr "Не вдалося безпечно виділити {word}, нічого не замінено"

#. Translators: Spoken when the selection changed during the spelling check, so
#. nothing is corrected.
#: globalPlugins/typix/__init__.py:592
msgid "The selection changed, nothing replaced"
msgstr "Виділення змінилося, нічого не замінено"

#. Translators: Spoken after the selection check corrected the words.
#: globalPlugins/typix/__init__.py:624
msgid "Corrected"
msgstr "Виправлено"

#. Translators: Name of a sound category: lowercase letters and digits.
#: globalPlugins/typix/settings.py:27
msgid "Letters"
msgstr "Літери"

#. Translators: Name of a sound category: capital letters.
#: globalPlugins/typix/settings.py:29
msgid "Capital letters"
msgstr "Великі літери"

#. Translators: Name of a sound category: the space bar.
#: globalPlugins/typix/settings.py:31
msgid "Space"
msgstr "Пробіл"

#. Translators: Name of a sound category: the Enter key.
#: globalPlugins/typix/settings.py:33
msgid "Enter"
msgstr "Enter"

#. Translators: Name of a sound category: the Tab key.
#: globalPlugins/typix/settings.py:35
msgid "Tab"
msgstr "Tab"

#. Translators: Name of a sound category: the Backspace key.
#: globalPlugins/typix/settings.py:37
msgid "Backspace"
msgstr "Backspace"

#. Translators: Name of a sound category: the Delete key.
#: globalPlugins/typix/settings.py:39
msgid "Delete"
msgstr "Delete"

#. Translators: Name of a sound category: punctuation, currency and other
#. symbols.
#: globalPlugins/typix/settings.py:41
msgid "Punctuation and symbols"
msgstr "Розділові знаки та символи"

#. Translators: Name of a sound category: the alert played after a misspelled
#. word.
#: globalPlugins/typix/settings.py:43
msgid "Misspelled word"
msgstr "Слово з помилкою"

#. Translators: Name of a sound category: played when a text replacement rule
#. changes what you typed.
#: globalPlugins/typix/settings.py:45
msgid "Automatic replacement"
msgstr "Автоматична заміна"

#. Translators: How a capital letter is named in character lists. {char} is the
#. letter.
#: globalPlugins/typix/settings.py:78
#, python-brace-format
msgid "cap {char}"
msgstr "велика {char}"

#. Translators: Direction of a sound in stereo, used in the pan description
#. below.
#: globalPlugins/typix/settings.py:87
msgid "left"
msgstr "ліворуч"

#. Translators: Direction of a sound in stereo, used in the pan description
#. below.
#: globalPlugins/typix/settings.py:90
msgid "right"
msgstr "праворуч"

#. Translators: Describes a character's stereo position. {side} is left or
#. right, {amount} is 1 to 100.
#: globalPlugins/typix/settings.py:92
#, python-brace-format
msgid "pan {side} {amount}"
msgstr "панорама {side} {amount}"

#. Translators: Describes a character's pitch change. {semitones} is a signed
#. number like +2.0.
#: globalPlugins/typix/settings.py:95
#, python-brace-format
msgid "pitch {semitones:+.1f} semitones"
msgstr "висота в півтонах {semitones:+.1f}"

#. Translators: Shown for a character with neither pan nor pitch set.
#: globalPlugins/typix/settings.py:97
msgid "no effects"
msgstr "без ефектів"

#. Translators: Prompt of the dialog that asks for a single character.
#: globalPlugins/typix/settings.py:114
msgid "Type one character, for example , or . or @:"
msgstr "Введіть один символ, наприклад , або . або @:"

#. Translators: Title of dialogs about choosing a single character.
#: globalPlugins/typix/settings.py:116 globalPlugins/typix/settings.py:128
msgid "Character"
msgstr "Символ"

#. Translators: Error when more or less than one character was typed.
#: globalPlugins/typix/settings.py:126
msgid "Please enter exactly one character."
msgstr "Введіть рівно один символ."

#. Translators: File type filter in the open file dialog. Keep the |*.wav part
#. unchanged.
#: globalPlugins/typix/settings.py:145
msgid "WAV files (*.wav)|*.wav"
msgstr "Файли WAV (*.wav)|*.wav"

#. Translators: Title of the pan and pitch dialog. {char} is the character's
#. spoken name.
#: globalPlugins/typix/settings.py:157
#, python-brace-format
msgid "Effects for {char}"
msgstr "Ефекти для {char}"

#. Translators: Label of the pan field in the effects dialog.
#: globalPlugins/typix/settings.py:162
msgid "&Pan, from -100 full left through 0 centre to 100 full right:"
msgstr "&Панорама, від -100 повністю ліворуч через 0 у центрі до 100 повністю праворуч:"

#. Translators: Label of the pitch field in the effects dialog.
#: globalPlugins/typix/settings.py:167
msgid "P&itch in semitones, negative is lower:"
msgstr "&Висота в півтонах, від'ємне значення нижче:"

#. Translators: Title of the dialog for adding or editing a text replacement.
#: globalPlugins/typix/settings.py:188 globalPlugins/typix/settings.py:214
msgid "Text replacement"
msgstr "Заміна тексту"

#. Translators: Label of the field for the word you type to trigger a text
#. replacement.
#: globalPlugins/typix/settings.py:192
msgid "&Shortcut, one word you type:"
msgstr "&Скорочення, одне слово, яке ви вводите:"

#. Translators: Label of the field for the text a shortcut becomes.
#: globalPlugins/typix/settings.py:194
msgid "&Becomes:"
msgstr "&Замінюється на:"

#. Translators: Error when a text replacement's shortcut isn't a single word or
#. the text is empty.
#: globalPlugins/typix/settings.py:212
msgid "The shortcut must be a single word, letters and digits only, and the text can't be empty."
msgstr "Скорочення має бути одним словом лише з літер і цифр, а текст не може бути порожнім."

#. Translators: Title of the sound pack editor. {name} is the pack name.
#: globalPlugins/typix/settings.py:229
#, python-brace-format
msgid "Edit sound pack {name}"
msgstr "Редагування пакета звуків {name}"

#. Translators: Group in the pack editor holding the pack's name, author and
#. description.
#: globalPlugins/typix/settings.py:243
msgid "Details"
msgstr "Відомості"

#. Translators: Label of the pack name field.
#: globalPlugins/typix/settings.py:245
msgid "&Name:"
msgstr "&Назва:"

#. Translators: Label of the pack author field.
#: globalPlugins/typix/settings.py:247
msgid "&Author:"
msgstr "&Автор:"

#. Translators: Label of the pack description field.
#: globalPlugins/typix/settings.py:250
msgid "&Description:"
msgstr "&Опис:"

#. Translators: Group in the pack editor for the sounds of each category.
#: globalPlugins/typix/settings.py:256
msgid "Category sounds"
msgstr "Звуки категорій"

#. Translators: Label of the list of sound categories in the pack editor.
#: globalPlugins/typix/settings.py:258
msgid "Ca&tegory:"
msgstr "&Категорія:"

#. Translators: Label of the list of sound files in the selected category.
#: globalPlugins/typix/settings.py:261
msgid "Sound &file:"
msgstr "&Файл звуку:"

#. Translators: Button that plays the selected sound file.
#: globalPlugins/typix/settings.py:264
msgid "&Play"
msgstr "&Відтворити"

#. Translators: Button that replaces all sounds of the selected category with
#. chosen files.
#: globalPlugins/typix/settings.py:266
msgid "&Replace sounds..."
msgstr "&Замінити звуки..."

#. Translators: Button that adds more sound files to the selected category.
#: globalPlugins/typix/settings.py:268
msgid "Add &variation..."
msgstr "&Додати варіант..."

#. Translators: Button that removes the selected sound file from the category.
#: globalPlugins/typix/settings.py:270
msgid "Remove &sound"
msgstr "&Прибрати звук"

#. Translators: Group in the pack editor for per-character sounds and effects.
#: globalPlugins/typix/settings.py:275
msgid "Characters"
msgstr "Символи"

#. Translators: Label of the list of characters with their own sound or
#. effects.
#: globalPlugins/typix/settings.py:277
msgid "C&haracter:"
msgstr "&Символ:"

#. Translators: Button that adds a character with its own sound or effects.
#: globalPlugins/typix/settings.py:280
msgid "Add &character..."
msgstr "Додати с&имвол..."

#. Translators: Button that chooses sound files for the selected character.
#: globalPlugins/typix/settings.py:282
msgid "Choose s&ound..."
msgstr "Виб&рати звук..."

#. Translators: Button that opens the pan and pitch dialog for the selected
#. character.
#: globalPlugins/typix/settings.py:284
msgid "Set &effects..."
msgstr "&Ефекти..."

#. Translators: Button that plays the selected character with its pan and
#. pitch.
#: globalPlugins/typix/settings.py:286
msgid "Previe&w"
msgstr "Прос&лухати"

#. Translators: Button that removes the selected character's sound and effects.
#: globalPlugins/typix/settings.py:288
msgid "Re&move character"
msgstr "Прибрати си&мвол"

#. Translators: Shown next to a category with no sound files.
#: globalPlugins/typix/settings.py:310
msgid "no sound"
msgstr "немає звуку"

#. Translators: Number of sound files in a category. {n} is the number.
#: globalPlugins/typix/settings.py:313
#, python-brace-format
msgid "{n} sound"
msgid_plural "{n} sounds"
msgstr[0] "{n} звук"
msgstr[1] "{n} звуки"
msgstr[2] "{n} звуків"

#. Translators: Title of the file dialog for choosing sounds. {category} is a
#. category name.
#: globalPlugins/typix/settings.py:339
#, python-brace-format
msgid "Choose sounds for {category}"
msgstr "Виберіть звуки для категорії {category}"

#. Translators: Shown for a character without its own sound, which uses its
#. category's sound.
#: globalPlugins/typix/settings.py:364
msgid "category sound"
msgstr "звук категорії"

#. Translators: Title of the file dialog for choosing sounds. {char} is the
#. character's spoken name.
#: globalPlugins/typix/settings.py:379 globalPlugins/typix/settings.py:390
#, python-brace-format
msgid "Choose sounds for {char}"
msgstr "Виберіть звуки для {char}"

#. Translators: Message after saving a pack when some files failed. A list of
#. errors follows.
#: globalPlugins/typix/settings.py:433
msgid "Some sounds could not be saved:"
msgstr "Не вдалося зберегти деякі звуки:"

#. Translators: Title of message boxes about a sound pack.
#. Translators: Group in Typix settings for choosing and managing sound packs.
#: globalPlugins/typix/settings.py:435 globalPlugins/typix/settings.py:680
msgid "Sound pack"
msgstr "Пакет звуків"

#. Translators: Title of the custom spelling dictionary dialog.
#: globalPlugins/typix/settings.py:446
msgid "Typix custom dictionary"
msgstr "Власний словник Typix"

#. Translators: Label of the list of words in the custom dictionary.
#: globalPlugins/typix/settings.py:450
msgid "&Words:"
msgstr "&Слова:"

#. Translators: Button that adds a word to the custom dictionary.
#: globalPlugins/typix/settings.py:453
msgid "&Add word..."
msgstr "&Додати слово..."

#. Translators: Button that removes the selected word from the custom
#. dictionary.
#: globalPlugins/typix/settings.py:455
msgid "&Remove word"
msgstr "В&идалити слово"

#. Translators: Prompt of the dialog that asks for a word to add to the
#. dictionary.
#: globalPlugins/typix/settings.py:476
msgid "Word to add:"
msgstr "Слово, яке треба додати:"

#. Translators: Title of the dialog that asks for a word to add to the
#. dictionary.
#: globalPlugins/typix/settings.py:478
msgid "Add word"
msgstr "Додати слово"

#. Translators: Prompt of the dialog that asks for the word's language code.
#: globalPlugins/typix/settings.py:488
msgid "Language of the word, for example en_US, en_GB or fr_FR:"
msgstr "Мова слова, наприклад uk_UA, en_US або en_GB:"

#. Translators: Title of the dialog that asks for the word's language code.
#: globalPlugins/typix/settings.py:490
msgid "Language"
msgstr "Мова"

#. Translators: Shown in the typing statistics instead of a speed when too
#. little was typed to measure it.
#: globalPlugins/typix/settings.py:510
msgid "not enough typing to measure"
msgstr "замало тексту для вимірювання"

#. Translators: A typing speed in the typing statistics. {wpm} is the number of
#. words per minute.
#: globalPlugins/typix/settings.py:512
#, python-brace-format
msgid "{wpm} word per minute"
msgid_plural "{wpm} words per minute"
msgstr[0] "{wpm} слово на хвилину"
msgstr[1] "{wpm} слова на хвилину"
msgstr[2] "{wpm} слів на хвилину"

#. Translators: Time spent typing in the typing statistics, when it's under a
#. minute.
#: globalPlugins/typix/settings.py:519
msgid "less than a minute"
msgstr "менше хвилини"

#. Translators: Part of the time spent typing in the typing statistics.
#: globalPlugins/typix/settings.py:524
#, python-brace-format
msgid "{n} hour"
msgid_plural "{n} hours"
msgstr[0] "{n} година"
msgstr[1] "{n} години"
msgstr[2] "{n} годин"

#. Translators: Part of the time spent typing in the typing statistics.
#: globalPlugins/typix/settings.py:527
#, python-brace-format
msgid "{n} minute"
msgid_plural "{n} minutes"
msgstr[0] "{n} хвилина"
msgstr[1] "{n} хвилини"
msgstr[2] "{n} хвилин"

#. Translators: Line in the typing statistics.
#: globalPlugins/typix/settings.py:534
#, python-brace-format
msgid "Words: {n}"
msgstr "Слова: {n}"

#. Translators: Line in the typing statistics.
#: globalPlugins/typix/settings.py:536
#, python-brace-format
msgid "Characters typed: {n}"
msgstr "Введені символи: {n}"

#. Translators: Line in the typing statistics.
#: globalPlugins/typix/settings.py:538
#, python-brace-format
msgid "Characters deleted with Backspace: {n}"
msgstr "Символи, видалені клавішею Backspace: {n}"

#. Translators: Line in the typing statistics.
#: globalPlugins/typix/settings.py:540
#, python-brace-format
msgid "Misspellings: {n}"
msgstr "Помилки: {n}"

#. Translators: Line in the typing statistics. {time} is a time like 1 hour 5
#. minutes.
#: globalPlugins/typix/settings.py:542
#, python-brace-format
msgid "Time spent typing: {time}"
msgstr "Час набору: {time}"

#. Translators: Line in the typing statistics. {speed} is a speed like 40 words
#. per minute.
#: globalPlugins/typix/settings.py:544
#, python-brace-format
msgid "Average speed: {speed}"
msgstr "Середня швидкість: {speed}"

#. Translators: Line in the typing statistics. {rate} is a number like 2.5.
#: globalPlugins/typix/settings.py:548
#, python-brace-format
msgid "Misspellings per 100 words: {rate}"
msgstr "Помилок на 100 слів: {rate}"

#. Translators: Part of the statistics summary: speed of the stretch being
#. typed now. {speed} is a speed like 40 words per minute.
#: globalPlugins/typix/settings.py:558
#, python-brace-format
msgid "Current speed: {speed}"
msgstr "Поточна швидкість: {speed}"

#. Translators: Part of the statistics summary. {speed} is a speed like 40
#. words per minute.
#: globalPlugins/typix/settings.py:561
#, python-brace-format
msgid "Average speed today: {speed}"
msgstr "Середня швидкість сьогодні: {speed}"

#. Translators: Part of the statistics summary.
#: globalPlugins/typix/settings.py:563
#, python-brace-format
msgid "Words today: {n}"
msgstr "Слів сьогодні: {n}"

#. Translators: Part of the statistics summary.
#: globalPlugins/typix/settings.py:565
#, python-brace-format
msgid "Misspellings today: {n}"
msgstr "Помилок сьогодні: {n}"

#. Translators: Part of the statistics summary. {speed} is a speed like 40
#. words per minute.
#: globalPlugins/typix/settings.py:568
#, python-brace-format
msgid "Average speed over all days: {speed}"
msgstr "Середня швидкість за всі дні: {speed}"

#. Translators: Line in the typing statistics: the fastest stretch of at least
#. 50 keys. {speed} is a speed like 40 words per minute.
#: globalPlugins/typix/settings.py:571 globalPlugins/typix/settings.py:583
#, python-brace-format
msgid "Best speed: {speed}"
msgstr "Найкраща швидкість: {speed}"

#. Translators: Heading in the typing statistics.
#: globalPlugins/typix/settings.py:574
msgid "Today"
msgstr "Сьогодні"

#. Translators: Heading in the typing statistics.
#: globalPlugins/typix/settings.py:576
msgid "Last 7 days"
msgstr "Останні 7 днів"

#. Translators: Heading in the typing statistics.
#: globalPlugins/typix/settings.py:578
msgid "All time"
msgstr "За весь час"

#. Translators: Line in the typing statistics: how many days have any typing.
#: globalPlugins/typix/settings.py:580
#, python-brace-format
msgid "Days with typing: {n}"
msgstr "Днів із набором: {n}"

#. Translators: Line in the typing statistics. {day} is a date, {words} the
#. words typed that day.
#: globalPlugins/typix/settings.py:587
#, python-brace-format
msgid "Busiest day: {day}, words {words}"
msgstr "Найактивніший день: {day}, слів {words}"

#. Translators: Heading in the typing statistics, above one line for each of
#. the last days with typing.
#: globalPlugins/typix/settings.py:590
msgid "Recent days"
msgstr "Останні дні"

#. Translators: One day in the typing statistics. {day} is a date, {speed} a
#. speed like 40 words per minute.
#: globalPlugins/typix/settings.py:594
#, python-brace-format
msgid "{day}: words {words}, misspellings {misspellings}, speed {speed}"
msgstr "{day}: слів {words}, помилок {misspellings}, швидкість {speed}"

#. Translators: Title of the typing statistics dialog.
#: globalPlugins/typix/settings.py:607
msgid "Typing statistics"
msgstr "Статистика набору"

#. Translators: Label of the read-only field in the typing statistics dialog.
#: globalPlugins/typix/settings.py:612
msgid "&Statistics:"
msgstr "&Статистика:"

#. Translators: Checkbox that turns all typing sounds on or off.
#: globalPlugins/typix/settings.py:646
msgid "&Play typing sounds"
msgstr "&Відтворювати звуки набору"

#. Translators: Group in Typix settings for volume, panning and sound
#. categories.
#: globalPlugins/typix/settings.py:650
msgid "Sounds"
msgstr "Звуки"

#. Translators: Label of the typing sound volume slider.
#: globalPlugins/typix/settings.py:653
msgid "&Volume:"
msgstr "&Гучність:"

#. Translators: Checkbox that lets each key sound from its own place in stereo.
#: globalPlugins/typix/settings.py:657
msgid "Stereo pannin&g per key"
msgstr "&Стереопанорама для кожної клавіші"

